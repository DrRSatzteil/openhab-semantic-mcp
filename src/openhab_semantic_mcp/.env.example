# OpenHAB Configuration
OPENHAB_BASE_URL=https://your-openhab-instance.org
OPENHAB_API_TOKEN=your_api_token_here

# MCP Server Configuration
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_TRANSPORT=streamable-http
LOG_LEVEL=INFO

# Inventory Refresh Configuration
INVENTORY_REFRESH_MINUTES=60

# Monitoring Configuration
MONITORING_WEBHOOK_URL=https://your-webhook-endpoint.org/webhook
MONITORING_WEBHOOK_AUTH_HEADER=Authorization: Bearer your_webhook_token
MONITORING_STORAGE_TYPE=memory
# MONITORING_TIMEZONE=Europe/Berlin  # Optional: defaults to UTC if not set

# Monitoring Cleanup Configuration
MONITORING_CLEANUP_INTERVAL_MINUTES=60
MONITORING_RETAIN_COMPLETED_DAYS=7
MONITORING_RETAIN_CANCELLED_DAYS=3
MONITORING_RETAIN_ERROR_DAYS=7
MONITORING_ENABLE_AUTO_CLEANUP=true

# Storage Backend Configuration (JSON object)
# Each backend can have its own configuration section
# Examples for different backends:

# CalDAV storage example:
# MONITORING_STORAGE_CONFIG='{"caldav": {"url": "https://caldav.example.org", "username": "user", "password": "pass", "calendar_name": "monitoring", "sync_interval": 300}}'

# Memory storage example (default):
# MONITORING_STORAGE_CONFIG='{"memory": {}}'

# File storage example:
# MONITORING_STORAGE_CONFIG='{"file": {"file_path": "/path/to/monitoring_tasks.json"}}'

MONITORING_STORAGE_CONFIG='{"memory": {}}'
